# Vercel server environment variable only. Never place the real key in index.html.
# Use a Google AI Studio Free Tier project with no paid billing upgrade.
GEMINI_API_KEY=
# Optional alternative, selected explicitly after checking the account is Free.
# Set AI_PROVIDER=groq and GROQ_API_KEY together. No automatic provider fallback.
AI_PROVIDER=groq
GROQ_API_KEY=
